FROM python:3.12-slim

# Prevent prompts during apt-get
ENV DEBIAN_FRONTEND=noninteractive

# Install dependencies needed for poetry and postgres client
RUN apt-get update && apt-get install -y curl postgresql-client && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Setup Poetry
RUN pip install poetry==1.8.2
ENV POETRY_NO_INTERACTION=1 \
    POETRY_VIRTUALENVS_CREATE=false

# Setup Backend
WORKDIR /app/api
COPY apps/api/pyproject.toml apps/api/poetry.lock* ./
RUN poetry install --no-root --without dev
COPY apps/api/ ./

# Expose API port for Pod / Container deployment
EXPOSE 8000

# Health check for persistent HTTP server mode (skips in Serverless mode)
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD if [ "$RUNPOD_MODE" = "serverless" ]; then exit 0; else curl -f http://localhost:8000/health || exit 1; fi

# Start script supporting both Pod and Serverless runtimes
COPY scripts/start_api.sh /app/start_api.sh
RUN chmod +x /app/start_api.sh

CMD ["/app/start_api.sh"]

