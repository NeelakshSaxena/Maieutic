# ==============================================================================
# NOTE: Fully local mode (Docker Compose + Ollama) needs NO .env file - the
# defaults in docker-compose.yml already point at Ollama. Do not copy this file
# to .env for local use: its active values below are the RunPod placeholders.
# Copy it only for RunPod modes (see DEPLOYMENT.md), and never commit .env.
# ==============================================================================
# ==============================================================================
# MentorAI - Master Environment Configuration Template
# ==============================================================================
# Select your deployment configuration below. Copy to .env and adjust values.

# ------------------------------------------------------------------------------
# MODE 1 & 2: Remote Inference (RunPod Serverless / Pod / vLLM)
# ------------------------------------------------------------------------------
# LLM Provider: 'runpod' or 'openai'
LLM_PROVIDER=runpod

# Transform Model (Socratic Planner, Verifier, Hint Generation)
TRANSFORM_BASE_URL=https://api.runpod.ai/v2/<RUNPOD_ENDPOINT_ID>/openai/v1
TRANSFORM_API_KEY=<RUNPOD_API_KEY>
TRANSFORM_MODEL=mentorai

# Optional Judge / Evaluator Model
JUDGE_BASE_URL=https://api.runpod.ai/v2/<RUNPOD_ENDPOINT_ID>/openai/v1
JUDGE_API_KEY=<RUNPOD_API_KEY>
JUDGE_MODEL=mentorai

# RunPod Execution Mode (Set to 'serverless' when deploying as a RunPod Worker)
# RUNPOD_MODE=serverless

# ------------------------------------------------------------------------------
# MODE 3: Local Inference (Ollama)
# ------------------------------------------------------------------------------
# LLM_PROVIDER=ollama
# From the API container to an Ollama running on the Docker host / a separate container with port 11434 published:`n#   http://host.docker.internal:11434/v1  (verified). Use http://ollama:11434/v1 only with `--profile bundled-ollama`.
# For local host processes connecting to Ollama, use http://localhost:11434/v1
# TRANSFORM_BASE_URL=http://host.docker.internal:11434/v1
# TRANSFORM_API_KEY=ollama
# TRANSFORM_MODEL=qwen3.5-aggressive:latest
# JUDGE_BASE_URL=http://host.docker.internal:11434/v1
# JUDGE_API_KEY=ollama
# JUDGE_MODEL=qwen3.5-aggressive:latest

# ------------------------------------------------------------------------------
# Database & State Services
# ------------------------------------------------------------------------------
# PostgreSQL (Default in Docker Compose):
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/mentorai

# SQLite (Alternative for standalone Pods or local testing):
# DATABASE_URL=sqlite:///./maieutic.db

# Redis & Vector Storage (Qdrant)
REDIS_URL=redis://redis:6379
QDRANT_URL=http://qdrant:6333

# ------------------------------------------------------------------------------
# Networking & Security
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4000,http://127.0.0.1:4000

