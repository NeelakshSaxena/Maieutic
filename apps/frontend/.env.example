# ==============================================================================
# MentorAI Frontend - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local frontend development:
#   cp .env.example .env.local

# ------------------------------------------------------------------------------
# OPTION A: Remote RunPod Pod / Local FastAPI / Docker Compose (HTTP API)
# ------------------------------------------------------------------------------
# When running with a local FastAPI backend:
API_INTERNAL_URL=http://127.0.0.1:8000
# When running inside Docker Compose:
# API_INTERNAL_URL=http://api:8000
# When pointing to a remote RunPod GPU/CPU Pod:
# API_INTERNAL_URL=https://<POD_ID>-8000.proxy.runpod.net

# ------------------------------------------------------------------------------
# OPTION B: RunPod Serverless Endpoint (Direct Worker Invocations)
# ------------------------------------------------------------------------------
# If targeting a RunPod Serverless Worker instead of a Pod HTTP server,
# set these server-side variables (the Next.js server proxies and authenticates):
# RUNPOD_SERVERLESS_ENDPOINT_ID=<YOUR_SERVERLESS_ENDPOINT_ID>
# RUNPOD_API_KEY=<YOUR_RUNPOD_API_KEY>
# Or specify full URL:
# RUNPOD_SERVERLESS_URL=https://api.runpod.ai/v2/<YOUR_SERVERLESS_ENDPOINT_ID>/runsync

# ------------------------------------------------------------------------------
# Client-Side Settings (Exposed to browser, defaults to internal proxies)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_HEALTH_URL=/health/llm
