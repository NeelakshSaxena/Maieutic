# Stage 1: Build the Next.js Frontend
FROM node:20-alpine AS frontend-builder
WORKDIR /app
COPY apps/frontend/package*.json ./
RUN npm ci
COPY apps/frontend/ ./
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

# Stage 2: Final RunPod Image (vLLM + FastAPI + Next.js Runtime)
FROM vllm/vllm-openai:v0.6.2

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install Node.js, Curl, and PostgreSQL client
RUN apt-get update && apt-get install -y curl postgresql-client && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install Poetry for the Python Backend
RUN pip install poetry==1.8.2
ENV POETRY_NO_INTERACTION=1 \
    POETRY_VIRTUALENVS_CREATE=false

# Setup Backend (FastAPI)
WORKDIR /app/api
COPY apps/api/pyproject.toml apps/api/poetry.lock* ./
RUN poetry install --no-root --without dev
COPY apps/api/ ./

# Setup Frontend (Next.js Standalone)
WORKDIR /app/frontend
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

COPY --from=frontend-builder /app/next.config.ts ./
COPY --from=frontend-builder /app/public ./public
COPY --from=frontend-builder /app/.next/standalone ./
COPY --from=frontend-builder /app/.next/static ./.next/static

# Copy scripts
WORKDIR /app
COPY scripts/runpod_entrypoint.sh /app/runpod_entrypoint.sh
COPY scripts/model_bootstrap.sh /app/model_bootstrap.sh
RUN chmod +x /app/runpod_entrypoint.sh /app/model_bootstrap.sh

# Expose Next.js port
EXPOSE 3000

# Start all services
CMD ["/bin/bash", "/app/runpod_entrypoint.sh"]
